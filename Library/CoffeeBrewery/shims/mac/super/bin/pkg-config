#!/bin/bash

# COFFEEBREWER_OPT and COFFEEBREWER_SDKROOT are set by extend/ENV/super.rb
# shellcheck disable=SC2154
pkg_config="${COFFEEBREWER_OPT}/pkg-config/bin/pkg-config"

if [[ -z "${COFFEEBREWER_SDKROOT}" ]]
then
  exec "${pkg_config}" "$@"
fi

exec "${pkg_config}" \
  "--define-variable=homebrew_sdkroot=${COFFEEBREWER_SDKROOT}" \
  "$@"
