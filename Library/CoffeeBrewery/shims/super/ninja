#!/bin/bash

# COFFEEBREWER_LIBRARY is set by bin/coffee
# COFFEEBREWER_CCCFG and COFFEEBREWER_OPT are set by extend/ENV/super.rb
# shellcheck disable=SC2154
if [[ -z "${COFFEEBREWER_LIBRARY}" ]]
then
  echo "${0##*/}: This shim is internal and must be run via coffee." >&2
  exit 1
fi

source "${COFFEEBREWER_LIBRARY}/CoffeeBrewery/shims/utils.sh"

parallel_args=()
# Defer to a POSIX FIFO jobserver if MAKEFLAGS advertises one; -j would
# disable ninja's jobserver client. Other modes aren't usable on POSIX.
if [[ -n "${COFFEEBREWER_MAKE_JOBS}" && "${MAKEFLAGS}" != *"--jobserver-auth=fifo:"* ]]
then
  parallel_args+=(-j "${COFFEEBREWER_MAKE_JOBS}")
fi

# shellcheck disable=SC2154
export COFFEEBREWER_CCCFG="O${COFFEEBREWER_CCCFG}"
try_exec_non_system "ninja" "${parallel_args[@]}" "$@"

echo "ninja: Shim failed to find ninja in PATH."
exit 1
