#!/bin/bash -p

# Make our $COFFEEBREWER_CURL selection universal - including in formulae usage.

# COFFEEBREWER_LIBRARY is set by bin/coffee
# COFFEEBREWER_CURL is set by coffee.sh
# shellcheck disable=SC2154
if [[ -z "${COFFEEBREWER_LIBRARY}" ]]
then
  echo "${0##*/}: This shim is internal and must be run via coffee." >&2
  exit 1
fi

source "${COFFEEBREWER_LIBRARY}/CoffeeBrewery/shims/utils.sh"

# SSL_CERT_FILE alone does not clear the CAPath setting.
set_certs=0
if [[ -n "${SSL_CERT_FILE}" ]]
then
  set_certs=1
  for arg in "$@"
  do
    if [[ "${arg}" =~ ^--ca(cert|path)$ ]]
    then
      # User passed their own settings - don't use ours!
      set_certs=0
    fi
  done
fi
if [[ ${set_certs} -eq 1 ]]
then
  CURL_DISABLE_CURLRC_ARGS=()
  # Keep the caller's curlrc opt-out first, or curl silently loads its defaults.
  # See setup_curl_args in utils/curl.sh for CoffeeBrewery's opt-in behaviour.
  if [[ "$1" == "-q" || "$1" == "--disable" ]]
  then
    CURL_DISABLE_CURLRC_ARGS=("$1")
    shift
  fi
  set -- "${CURL_DISABLE_CURLRC_ARGS[@]}" "--cacert" "${SSL_CERT_FILE}" "--capath" "$(dirname "${SSL_CERT_FILE}")" "$@"
fi

if [[ -n "${COFFEEBREWER_CURL}" && "${COFFEEBREWER_CURL}" != curl ]]
then
  safe_exec "${COFFEEBREWER_CURL}" "$@"
else
  try_exec_non_system curl "$@"
  safe_exec "/usr/bin/curl" "$@"
fi

echo "Could not execute curl. Try setting COFFEEBREWER_FORCE_BREWED_CURL=1" >&2
exit 1
