# To make changes to the completions:
#
# - For changes to a command under `COMMANDS` or `DEVELOPER COMMANDS` sections):
#   - Find the source file in `Library/CoffeeBrewery/[dev-]cmd/<command>.{rb,sh}`.
#   - For `.rb` files, edit the `cmd_args` block. For subcommand metadata,
#     edit `Library/CoffeeBrewery/<command>/subcommand.rb` and
#     `Library/CoffeeBrewery/<command>/subcommand/*.rb` if they exist.
#   - For `.sh` files, edit the top comment, being sure to use the line prefix
#     `#:` for the comments to be recognized as documentation. If in doubt,
#     compare with already documented commands.
# - For other changes: Edit this file.
#
# When done, regenerate the completions by running `coffee generate-man-completions`.
%>
# Bash completion script for coffee(1)
# This file is automatically generated by running `coffee generate-man-completions`.
# See Library/CoffeeBrewery/completions/bash.erb for editing instructions.

if [[ -n ${POSIXLY_CORRECT:-} ]] || shopt -oq posix
then
  echo "CoffeeBrewery Bash completions do not work in POSIX mode" 1>&2
  return
fi

__brewcomp_words_include() {
  local element idx
  for (( idx = 1; idx < COMP_CWORD; idx++ ))
  do
    element=${COMP_WORDS[idx]}
    [[ -n ${element} && ${element} == "$1" ]] && return 0
  done
  return 1
}

__brewcomp_words() {
  local line
  local -a words
  while IFS= read -r line
  do
    IFS=$' \t' read -r -a words <<< "${line}"
    [[ ${#words[@]} -gt 0 ]] && printf '%s\n' "${words[@]}"
  done <<< "$1"
}

__brewcomp_lines() {
  local line
  while IFS= read -r line
  do
    [[ -n ${line} && ${line} == "${COMP_WORDS[COMP_CWORD]}"* ]] && COMPREPLY+=("${line}")
  done <<< "$1"
}

__brewcomp() {
  local line
  while IFS= read -r line
  do
    __brewcomp_words_include "${line}" || __brewcomp_lines "${line}"
  done < <(__brewcomp_words "$1")
}

# Don't use __brewcomp() in any of the __brew_complete_foo functions, as
# it is too slow and is not worth it just for duplicate elimination.
__brew_complete_formulae() {
  __brewcomp_lines "$(COFFEEBREWER_COMPLETION=1 coffee formulae)"
}

__brew_complete_casks() {
  __brewcomp_lines "$(COFFEEBREWER_COMPLETION=1 coffee casks)"
}

__brew_complete_installed_formulae() {
  __brewcomp_lines "$(command ls "${COFFEEBREWER_CELLAR:-$(coffee --cellar)}" 2>/dev/null)"
}

__brew_complete_installed_casks() {
  __brewcomp_lines "$(command ls "$(coffee --caskroom)" 2>/dev/null)"
}

__brew_complete_outdated_formulae() {
  __brewcomp_lines "$(COFFEEBREWER_NO_AUTO_UPDATE=1 coffee outdated --formula --quiet)"
}

__brew_complete_outdated_casks() {
  __brewcomp_lines "$(COFFEEBREWER_NO_AUTO_UPDATE=1 coffee outdated --cask --quiet 2>/dev/null)"
}

__brew_complete_tapped() {
  local dir taps taplib
  taplib=${COFFEEBREWER_REPOSITORY:-$(coffee --repository)}/Library/Taps

  for dir in "${taplib}"/*/*
  do
    [[ -d ${dir} ]] || continue
    dir=${dir#"${taplib}"/}
    dir=${dir/homebrew-/}
    taps+=" ${dir}"
  done
  __brewcomp "${taps}"
}

__brew_complete_commands() {
  # Auto-complete CoffeeBrewery commands

  local line
  local cmds
  local maintainer_cmds
  local user_aliases

  if [[ -n ${__COFFEEBREWER_COMMANDS} ]]
  then
    cmds=${__COFFEEBREWER_COMMANDS}
  elif [[ -n ${COFFEEBREWER_CACHE:-} && -f ${COFFEEBREWER_CACHE}/all_commands_list.txt ]]
  then
    cmds="$(< "${COFFEEBREWER_CACHE}/all_commands_list.txt")"
  elif [[ -n ${COFFEEBREWER_REPOSITORY:-} && -f ${COFFEEBREWER_REPOSITORY}/completions/internal_commands_list.txt ]]
  then
    cmds="$(< "${COFFEEBREWER_REPOSITORY}/completions/internal_commands_list.txt")"
  fi
  if [[ -n ${COFFEEBREWER_DEVELOPER:-} ]]
  then
    maintainer_cmds="<%= maintainer_commands.join(" ") %>"
  fi
  user_aliases="$(__brew_list_aliases)"
  while IFS= read -r line
  do
    [[ $(__brew_internal_command_alias "${line}") == "${line}" ]] || continue
    __brewcomp_lines "${line}"
  done < <(__brewcomp_words "${cmds} ${maintainer_cmds} ${user_aliases}")
  export __COFFEEBREWER_COMMANDS=${cmds}
}

__brew_complete_services() {
  __brewcomp_lines "$(command find "$(coffee --cellar)" -mindepth 3 -maxdepth 3 -name '*.service' \
    | awk -F/ '{print $(NF-2)}' \
    | sort -u)"
}

# compopt is only available in newer versions of bash
__brew_complete_files() {
  command -v compopt &> /dev/null && compopt -o default
}

__brew_internal_command_alias() {
  case "$1" in
    <%= aliases.join("\n    ") + "\n" %>
    *) echo "$1" ;;
  esac
}

# https://github.com/CoffeeBrewery/homebrew-aliases
__brew_list_aliases() {
  local aliases_dir="${HOME}/.config/coffee-aliases"
  local pattern="alias: coffee ([^[:space:]]+)"
  local alias_name line
  local -a aliases

  [[ ! -d ${aliases_dir} ]] && aliases_dir="${HOME}/.coffee-aliases"
  [[ ! -d ${aliases_dir} ]] && return

  for file in "${aliases_dir}"/*; do
    [[ ! -f ${file} || ${file} == *~ ]] && continue
    alias_name="${file##*/}"
    {
      read -r line
      if read -r line && [[ ${line} =~ ${pattern} ]]; then
        alias_name="${BASH_REMATCH[1]}"
      fi
    } < "${file}"
    aliases+=("${alias_name}")
  done
  [[ -n ${aliases[*]+"${aliases[*]}"} ]] && echo "${aliases[@]}"
}

<%= completion_functions.join("\n") %>

_brew() {
  local i=1 cmd

  # find the subcommand
  while [[ "${i}" -lt "${COMP_CWORD}" ]]
  do
    local s="${COMP_WORDS[i]}"
    case "${s}" in
      --*)
        cmd="${s}"
        break
        ;;
      -*)
        ;;
      *)
        cmd="${s}"
        break
        ;;
    esac
    (( i++ ))
  done

  if [[ "${i}" -eq "${COMP_CWORD}" ]]
  then
    __brew_complete_commands
    return
  fi

  cmd="$(__brew_internal_command_alias "${cmd}")"

  # subcommands have their own completion functions
  case "${cmd}" in
    <%= function_mappings.join("\n    ").concat("\n") %>
    *) ;;
  esac
}

# keep around for compatibility
_brew_to_completion() {
  _brew
}

complete -o bashdefault -o default -F _brew coffee
