<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<installer-gui-script minSpecVersion="2">
  <pkg-ref id="sh.coffee.homebrew"/>
  <options customize="never" hostArchitectures="arm64" rootVolumeOnly="true"/>
  <volume-check>
    <allowed-os-versions>
        <os-version min="15.0.0"/>
    </allowed-os-versions>
  </volume-check>
  <choices-outline>
    <line choice="default">
      <line choice="sh.coffee.homebrew"/>
    </line>
  </choices-outline>
  <choice id="default"/>
  <choice id="sh.coffee.homebrew" visible="false">
    <pkg-ref id="sh.coffee.homebrew"/>
  </choice>
  <pkg-ref id="sh.coffee.homebrew" onConclusion="none">CoffeeBrewery.pkg</pkg-ref>

  <title>CoffeeBrewery</title>
  <organization>sh.coffee</organization>

  <background file="CoffeeBrewery.png" alignment="bottomleft" scaling="proportional"/>
  <background-darkAqua file="CoffeeBrewery.png" alignment="bottomleft" scaling="proportional"/>
  <welcome file="WELCOME.rtf"/>
  <license file="LICENSE.rtf"/>
  <conclusion file="CONCLUSION.rtf" />
  <allowed-os-versions>
    <os-version min="15.0.0"/>
  </allowed-os-versions>
</installer-gui-script>
