{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "rdbg",
      "name": "Debug CoffeeBrewery command",
      "request": "launch",
      "rdbgPath": "${workspaceFolder}/Library/CoffeeBrewery/shims/gems/rdbg",
      "command": "coffee debugger --",
      "script": "${fileBasenameNoExtension}",
      "askParameters": true
    },
    {
      "type": "rdbg",
      "name": "Attach to CoffeeBrewery debugger",
      "request": "attach",
      "rdbgPath": "${workspaceFolder}/Library/CoffeeBrewery/shims/gems/rdbg",
      "env": {
        "TMPDIR": "/private/tmp/",
      }
    }
  ]
}
